# =====================================================================
# MindChain deployment config TEMPLATE.
# Setup:  cp config.example.env config.env   then edit config.env (never commit it).
# This file holds PRIVATE KEYS. Keep it on this machine only: never commit,
# share, upload or paste it. Devnet/testnet keys only, never mainnet.
# =====================================================================

# ---- Paths ----
MINDCHAIN_REPO="$HOME/mind-chain"        # clone of github.com/arunjot12/mind-chain
BIN="$ROOT/bin"                         # all binaries live here (bash scripts/build-binaries.sh fills it)
WORKDIR="$HOME/mindchain-deploy"         # deployment folder (use a new one per chain)

# ---- Chains ----
L1_CHAIN_ID=11155111                     # Sepolia
L2_CHAIN_ID=YOUR-L2-CHAIN-ID                 # pick an unused ID (check chainlist.org); cannot change after deploy
GENESIS_DELAY_MINUTES=15                 # L2 genesis = 15 min after you run step 3 (must cover steps 4-6: cached build ~10 min)

# ---- L1 endpoints (contain API keys: do not share this file) ----
L1_RPC_URL="https://YOUR-SEPOLIA-RPC-URL"        # used by mc-deployer and mc-node (needs low latency)
L1_TX_RPC_URL="$L1_RPC_URL"                      # used by batcher/proposer/challenger (separate key recommended)
L1_BEACON_URL="https://YOUR-SEPOLIA-BEACON-URL"  # Sepolia beacon API (blobs)
L1_TRUST_RPC=false                               # true only for a provider you trust (faster catch-up)

# ---- Role addresses (addresses only, never keys) ----
ADMIN="0xYOUR-ADMIN-ADDRESS"
SEQUENCER="0xYOUR-SEQUENCER-ADDRESS"
BATCHER="0xYOUR-BATCHER-ADDRESS"
PROPOSER="0xYOUR-PROPOSER-ADDRESS"
CHALLENGER="0xYOUR-CHALLENGER-ADDRESS"

# ---- Private keys (devnet only) ----
# Fill these to run scripts without prompts. Leave one empty to be asked instead.
# Each key is checked against the role address above before it is used.
ADMIN_PRIVATE_KEY=""          # bootstrap, prepare, continue, mint (must stay off servers)
SEQUENCER_PRIVATE_KEY=""      # not used yet (needed later for P2P block signing)
BATCHER_PRIVATE_KEY=""
PROPOSER_PRIVATE_KEY=""
CHALLENGER_PRIVATE_KEY=""

# ---- Custom gas token ----
GAS_TOKEN_NAME="Nila Token"
GAS_TOKEN_SYMBOL="NILA"
INITIAL_LIQUIDITY="0x1431e0fae6d7217caa0000000"   # 100,000,000,000 NILA (hard cap on L2)

# ---- Chain parameters ----
GAS_LIMIT=60000000
EIP1559_DENOMINATOR_CANYON=250
EIP1559_DENOMINATOR=50
EIP1559_ELASTICITY=6
RESPECTED_GAME_TYPE=9                    # SUPER_CANNON_KONA (permissionless)

# ---- Services ----
DA_TYPE=blobs                            # blobs | calldata
PROPOSAL_INTERVAL=6h                     # each proposal locks 0.08 ETH for ~10 days

# ---- Local ports ----
RETH_HTTP_PORT=9545
RETH_AUTH_PORT=9551
RETH_P2P_PORT=30304
NODE_RPC_PORT=8547
NODE_METRICS_PORT=7300
BATCHER_RPC_PORT=8548
PROPOSER_RPC_PORT=8560
